[Unit]
Description=qlvm VM management daemon
Requires=dbus.socket
After=dbus.socket network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/qlvm-agent
Restart=on-failure
RestartSec=5
# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/qlvm /var/lib/xen /run/qlvm /run/xen /run/openvswitch /run/ovn /run/podman
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
RuntimeDirectory=qlvm

[Install]
WantedBy=multi-user.target
