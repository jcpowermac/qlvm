[Unit]
Description=qlvm VM management daemon
Requires=dbus.socket
After=dbus.socket network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/qlvm-agent
Restart=on-failure
RestartSec=5
# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/qlvm /var/lib/xen /var/log/xen /run/qlvm /run/xen /run/openvswitch /run/ovn /run/podman
PrivateTmp=true
# No PrivateDevices: the Xen block hotplug script (child of this daemon)
# needs losetup on /dev/loop*, which requires the host loop nodes that a
# private /dev tmpfs lacks. Hardening is carried by NoNewPrivileges +
# ProtectSystem=strict + ProtectHome + the Restrict* lines below.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
RuntimeDirectory=qlvm

[Install]
WantedBy=multi-user.target
